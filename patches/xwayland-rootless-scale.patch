 }
 
+/* The rootless scale changed: show the surface at the new one */
+void
+xwl_window_apply_rootless_scale(struct xwl_window *xwl_window)
+{
+    xwl_window_check_resolution_change_emulation(xwl_window);
+
+    if (xwl_window->allow_commits)
+        wl_surface_commit(xwl_window->surface);
+}
