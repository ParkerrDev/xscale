+/* X11 cursors are drawn at the scale X11 clients render at: with a rootless
+ * scale, they are shown at their size divided by it, as the cursors of HiDPI
+ * Wayland clients are.
+ */
+static void
+xwl_cursor_set_scale(struct xwl_screen *xwl_screen,
+                     struct xwl_cursor *xwl_cursor, int width, int height)
+{
+    double scale = xwl_screen_get_rootless_scale(xwl_screen);
+    int destination_width, destination_height;
+
+    wl_surface_set_buffer_scale(xwl_cursor->surface, xwl_screen->global_surface_scale);
+
+    if (fabs(scale - 1.0) > 1e-6) {
+        if (!xwl_cursor->viewport)
+            xwl_cursor->viewport = wp_viewporter_get_viewport(xwl_screen->viewporter,
+                                                              xwl_cursor->surface);
+        destination_width = round(width / scale);
+        destination_height = round(height / scale);
+        wp_viewport_set_destination(xwl_cursor->viewport,
+                                    max(destination_width, 1),
+                                    max(destination_height, 1));
+    } else if (xwl_cursor->viewport) {
+        wp_viewport_destroy(xwl_cursor->viewport);
+        xwl_cursor->viewport = NULL;
+    }
+}
+
+/* A hotspot in surface-local coordinates */
+static int
+xwl_cursor_hotspot(struct xwl_screen *xwl_screen, int hot)
+{
+    double scale = xwl_screen_get_rootless_scale(xwl_screen);
+
+    return round((hot / xwl_screen->global_surface_scale) / scale);
+}
