+    // shown from it at its logical size on its own monitor.
+    float globalScale = xwaylandScale;
+    if (globalScale < 0.F) {
+        float highest = 1.F;
+        for (auto const& m : monitors)
+            highest = std::max(highest, m->scale());
+        globalScale = globalScale < -1.5F ? highest : std::ceil(highest - 0.001F);
+    }
+    if (globalScale > 0.F)
+        globalScale = std::max(1.F, globalScale);
+
     maxXOffsetRight = 0;
     for (auto const& m : monitors) {
-        Log::logger->log(Log::DEBUG, "arrangeMonitors: {} xwayland [{}, {}]", m->name(), maxXOffsetRight, 0);
+        Log::logger->log(Log::DEBUG, "arrangeMonitors: {} xwayland [{}, {}] scale {}", m->name(), maxXOffsetRight, 0,
+                         globalScale > 0.F ? globalScale : (xwaylandForceZeroScaling ? m->scale() : 1.F));
         m->setXWaylandPosition({maxXOffsetRight, 0});
+        if (globalScale > 0.F) {
+            maxXOffsetRight += std::round(m->size().x * globalScale);
+            m->setXWaylandScale(globalScale);
+            continue;
+        }
         maxXOffsetRight += xwaylandForceZeroScaling ? m->transformedSize().x : m->size().x;
         m->setXWaylandScale(xwaylandForceZeroScaling ? m->scale() : 1.F);
     }
