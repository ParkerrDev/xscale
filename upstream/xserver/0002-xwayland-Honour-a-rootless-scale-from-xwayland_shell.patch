diff --git a/hw/xwayland/xwayland-screen.c b/hw/xwayland/xwayland-screen.c
index 423bffe..0cb13f3 100644
--- a/hw/xwayland/xwayland-screen.c
+++ b/hw/xwayland/xwayland-screen.c
@@ -527,6 +527,67 @@ static const struct xdg_wm_base_listener xdg_wm_base_listener = {
     xdg_wm_base_ping,
 };
 
+double
+xwl_screen_get_rootless_scale(struct xwl_screen *xwl_screen)
+{
+    return xwl_screen->rootless_scale;
+}
+
+/* Lays out the outputs, the windows and the cursors at the scale X11 clients
+ * render at. Every surface is then shown at its buffer size divided by the
+ * scale, through wp_viewporter, so the scale needs it (and xdg-output, for the
+ * logical geometry of the outputs).
+ */
+void
+xwl_screen_set_rootless_scale(struct xwl_screen *xwl_screen, double scale)
+{
+    struct xwl_output *xwl_output;
+    struct xwl_window *xwl_window;
+    struct xwl_seat *xwl_seat;
+
+    /* A scale that is not one (nothing, a negative, a runaway) is no scale */
+    if (!(scale >= 0.25 && scale <= 8.0))
+        scale = 1.0;
+
+    if (!xwl_screen->rootless || !xwl_screen->compositor ||
+        !xwl_screen_has_viewport_support(xwl_screen) ||
+        !xwl_screen->xdg_output_manager)
+        scale = 1.0;
+
+    if (fabs(scale - xwl_screen->rootless_scale) < 1e-6)
+        return;
+
+    DebugF("XWAYLAND: rootless scale is now %f (was %f)\n",
+           scale, xwl_screen->rootless_scale);
+    xwl_screen->rootless_scale = scale;
+
+    /* All outputs first, so that the screen is only ever resized to the
+     * final size */
+    xorg_list_for_each_entry(xwl_output, &xwl_screen->output_list, link)
+        xwl_output_update_rootless_geometry(xwl_output);
+    xorg_list_for_each_entry(xwl_output, &xwl_screen->output_list, link)
+        xwl_output_apply_rootless_scale(xwl_output);
+
+    xorg_list_for_each_entry(xwl_window, &xwl_screen->window_list, link_window)
+        xwl_window_apply_rootless_scale(xwl_window);
+
+    xorg_list_for_each_entry(xwl_seat, &xwl_screen->seat_list, link)
+        xwl_seat_update_cursors(xwl_seat);
+}
+
+#ifdef XWAYLAND_SHELL_V1_SCALE_SINCE_VERSION
+static void
+xwayland_shell_handle_scale(void *data, struct xwayland_shell_v1 *xwayland_shell,
+                            uint32_t scale)
+{
+    xwl_screen_set_rootless_scale(data, (double) scale / XWL_ROOTLESS_SCALE_DENOMINATOR);
+}
+
+static const struct xwayland_shell_v1_listener xwayland_shell_listener = {
+    xwayland_shell_handle_scale,
+};
+#endif
+
 static void
 registry_global(void *data, struct wl_registry *registry, uint32_t id,
                 const char *interface, uint32_t version)
@@ -580,8 +641,19 @@ registry_global(void *data, struct wl_registry *registry, uint32_t id,
         xwl_screen->viewporter = wl_registry_bind(registry, id, &wp_viewporter_interface, 1);
     }
     else if (strcmp(interface, xwayland_shell_v1_interface.name) == 0 && xwl_screen->rootless) {
+#ifdef XWAYLAND_SHELL_V1_SCALE_SINCE_VERSION
+        /* Version 2 adds the scale X11 clients render at */
+        version = min(version, XWAYLAND_SHELL_V1_SCALE_SINCE_VERSION);
+#else
+        version = 1;
+#endif
         xwl_screen->xwayland_shell =
-            wl_registry_bind(registry, id, &xwayland_shell_v1_interface, 1);
+            wl_registry_bind(registry, id, &xwayland_shell_v1_interface, version);
+#ifdef XWAYLAND_SHELL_V1_SCALE_SINCE_VERSION
+        if (version >= XWAYLAND_SHELL_V1_SCALE_SINCE_VERSION)
+            xwayland_shell_v1_add_listener(xwl_screen->xwayland_shell,
+                                           &xwayland_shell_listener, xwl_screen);
+#endif
     }
     else if (strcmp(interface, wp_tearing_control_manager_v1_interface.name) == 0) {
         xwl_screen->tearing_control_manager =
@@ -1134,6 +1206,7 @@ xwl_screen_init(ScreenPtr pScreen, int argc, char **argv)
     xorg_list_init(&xwl_screen->pending_wl_surface_destroy);
     xwl_screen->depth = 24;
     xwl_screen->global_surface_scale = 1;
+    xwl_screen->rootless_scale = 1.0;
 
     if (!monitorResolution)
         monitorResolution = DEFAULT_DPI;
