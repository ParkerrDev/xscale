     xwl_surface_damage(xwl_screen, xwl_cursor->surface, 0, 0,
                        xwl_seat->x_cursor->bits->width,
                        xwl_seat->x_cursor->bits->height);
@@ -213,8 +255,8 @@ xwl_seat_set_cursor(struct xwl_seat *xwl_seat)
 
