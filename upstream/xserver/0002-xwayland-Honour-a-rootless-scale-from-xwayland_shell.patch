 }
 
+/* Tells X11 clients about the output again after the rootless scale changed.
+ * This is not an update from the compositor: whatever it is in the middle of
+ * sending is still to come.
+ */
+void
+xwl_output_apply_rootless_scale(struct xwl_output *xwl_output)
+{
+    Bool wl_output_done = xwl_output->wl_output_done;
+    Bool xdg_output_done = xwl_output->xdg_output_done;
+
+    apply_output_change(xwl_output);
+
+    xwl_output->wl_output_done = wl_output_done;
+    xwl_output->xdg_output_done = xdg_output_done;
+}
