+/* Enable the viewport for the rootless scale (xwayland_shell_v1.scale): the
+ * surface is shown at its buffer size divided by the scale, as the surface of
+ * a HiDPI Wayland client would be.
+ */
+static void
+xwl_window_enable_viewport_for_rootless_scale(struct xwl_window *xwl_window)
+{
+    struct xwl_screen *xwl_screen = xwl_window->xwl_screen;
+    WindowPtr window = xwl_window->toplevel;
+    double scale = xwl_screen_get_rootless_scale(xwl_screen);
+    int buffer_width, buffer_height, width, height;
+
+    buffer_width = window->drawable.width + 2 * window->borderWidth;
+    buffer_height = window->drawable.height + 2 * window->borderWidth;
+    width = round(buffer_width / scale);
+    height = round(buffer_height / scale);
+    width = max(width, 1);
+    height = max(height, 1);
+
+    if (!xwl_window_has_viewport_enabled(xwl_window))
+        xwl_window->viewport = wp_viewporter_get_viewport(xwl_screen->viewporter,
+                                                          xwl_window->surface);
+
+    DebugF("XWAYLAND: enabling viewport for rootless scale %dx%d -> %dx%d\n",
+           buffer_width, buffer_height, width, height);
+    /* The whole buffer, whatever its size when the destination applies */
+    wp_viewport_set_source(xwl_window->viewport,
+                           wl_fixed_from_int(-1),
+                           wl_fixed_from_int(-1),
+                           wl_fixed_from_int(-1),
+                           wl_fixed_from_int(-1));
+    wp_viewport_set_destination(xwl_window->viewport, width, height);
+
+    xwl_window->viewport_scale_x = (float) buffer_width / width;
+    xwl_window->viewport_scale_y = (float) buffer_height / height;
+    xwl_window_set_input_region(xwl_window, wInputShape(xwl_window->toplevel));
+}
