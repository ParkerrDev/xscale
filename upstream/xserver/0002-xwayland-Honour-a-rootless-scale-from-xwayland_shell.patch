+/* The geometry X11 clients see: the logical one times the rootless scale. The
+ * edges are scaled rather than the size, so that outputs next to each other in
+ * the compositor stay next to each other in X11.
+ */
+void
+xwl_output_update_rootless_geometry(struct xwl_output *xwl_output)
+{
+    double scale = xwl_screen_get_rootless_scale(xwl_output->xwl_screen);
+
+    xwl_output->logical_x = round(xwl_output->wl_x * scale);
+    xwl_output->logical_y = round(xwl_output->wl_y * scale);
+    xwl_output->logical_w =
+        round((xwl_output->wl_x + xwl_output->wl_w) * scale) - xwl_output->logical_x;
+    xwl_output->logical_h =
+        round((xwl_output->wl_y + xwl_output->wl_h) * scale) - xwl_output->logical_y;
+}
+
 static void
 output_handle_geometry(void *data, struct wl_output *wl_output, int x, int y,
                        int physical_width, int physical_height, int subpixel,
@@ -99,8 +116,9 @@ output_handle_geometry(void *data, struct wl_output *wl_output, int x, int y,
 
     /* Apply the change from wl_output only if xdg-output is not supported */
     if (!xwl_output->xdg_output) {
-        xwl_output->logical_x = x;
-        xwl_output->logical_y = y;
+        xwl_output->wl_x = x;
+        xwl_output->wl_y = y;
+        xwl_output_update_rootless_geometry(xwl_output);
     }
     xwl_output->rotation = wl_transform_to_xrandr(transform);
 }
@@ -116,8 +134,9 @@ output_handle_mode(void *data, struct wl_output *wl_output, uint32_t flags,
 
     /* Apply the change from wl_output only if xdg-output is not supported */
     if (!xwl_output->xdg_output) {
-        xwl_output->logical_w = width;
-        xwl_output->logical_h = height;
+        xwl_output->wl_w = width;
+        xwl_output->wl_h = height;
+        xwl_output_update_rootless_geometry(xwl_output);
     }
 
     xwl_output->mode_width = width;
@@ -139,6 +158,21 @@ output_get_logical_mode(struct xwl_output *xwl_output, int *width, int *height)
     }
 }
 
+/* The output's size in the compositor's coordinates */
+void
+output_get_wayland_extents(struct xwl_output *xwl_output, int *width, int *height)
+{
+    /* When we have xdg-output support the stored size is already rotated. */
+    if (xwl_output->xdg_output ||
+        (xwl_output->rotation & (RR_Rotate_0 | RR_Rotate_180))) {
+        *width = xwl_output->wl_w;
+        *height = xwl_output->wl_h;
+    } else {
+        *width = xwl_output->wl_h;
+        *height = xwl_output->wl_w;
+    }
+}
