From 1b8ff2a0a4b2395b82d693769cff91d545e33b33 Mon Sep 17 00:00:00 2001
From: ParkerrDev <114211845+ParkerrDev@users.noreply.github.com>
Date: Sun, 18 Oct 2026 22:35:47 -0700
Subject: [PATCH 1/3] xwayland: Scale surface-local pointer coordinates before
 rounding them

Pointer coordinates in a surface come as wl_fixed. Xwayland rounded them
down to whole numbers before multiplying them by the window's viewport
scale, so with a viewport the X11 pointer moved in steps of the scale,
and on enter it was not scaled at all.

Multiply first and keep the fraction: the X server takes absolute
motion as doubles. The enter position now accounts for the viewport too.
---
 hw/xwayland/xwayland-input.c | 20 +++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/hw/xwayland/xwayland-input.c b/hw/xwayland/xwayland-input.c
index 576b68c..f720641 100644
--- a/hw/xwayland/xwayland-input.c
+++ b/hw/xwayland/xwayland-input.c
@@ -541,9 +541,6 @@ pointer_handle_enter(void *data, struct wl_pointer *pointer,
     if (!is_surface_from_xwl_window(surface))
         return;
 
-    sx = wl_fixed_to_int(sx_w) * xwl_screen->global_surface_scale;
-    sy = wl_fixed_to_int(sy_w) * xwl_screen->global_surface_scale;
-
     xwl_seat->xwl_screen->serial = serial;
     xwl_seat->pointer_enter_serial = serial;
 
@@ -551,6 +548,11 @@ pointer_handle_enter(void *data, struct wl_pointer *pointer,
     dx = xwl_seat->focus_window->toplevel->drawable.x;
     dy = xwl_seat->focus_window->toplevel->drawable.y;
 
+    sx = wl_fixed_to_double(sx_w) * xwl_screen->global_surface_scale *
+         xwl_seat->focus_window->viewport_scale_x;
+    sy = wl_fixed_to_double(sy_w) * xwl_screen->global_surface_scale *
+         xwl_seat->focus_window->viewport_scale_y;
+
     /* We just entered a new xwindow, forget about the old last xwindow */
     xwl_seat->last_focus_window = NULL;
 
@@ -671,12 +673,12 @@ dispatch_absolute_motion(struct xwl_seat *xwl_seat)
     ValuatorMask mask;
     DeviceIntPtr device;
     int flags;
-    int event_x = wl_fixed_to_int(xwl_seat->pending_pointer_event.x);
-    int event_y = wl_fixed_to_int(xwl_seat->pending_pointer_event.y);
+    double event_x = wl_fixed_to_double(xwl_seat->pending_pointer_event.x);
+    double event_y = wl_fixed_to_double(xwl_seat->pending_pointer_event.y);
     int drawable_x = xwl_seat->focus_window->toplevel->drawable.x;
     int drawable_y = xwl_seat->focus_window->toplevel->drawable.y;
-    int x;
-    int y;
+    double x;
+    double y;
 
     event_x *= xwl_screen->global_surface_scale;
     event_y *= xwl_screen->global_surface_scale;
@@ -688,8 +690,8 @@ dispatch_absolute_motion(struct xwl_seat *xwl_seat)
     y = drawable_y + event_y;
 
     valuator_mask_zero(&mask);
-    valuator_mask_set(&mask, 0, x);
-    valuator_mask_set(&mask, 1, y);
+    valuator_mask_set_double(&mask, 0, x);
+    valuator_mask_set_double(&mask, 1, y);
 
     if (xwl_seat->pending_pointer_event.has_relative) {
          flags = POINTER_ABSOLUTE | POINTER_SCREEN | POINTER_NORAW;
