--- /dev/null
+++ b/protocols/xwayland-shell-v1.xml
@@ -0,0 +1,199 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="xwayland_shell_v1">
+
+  <copyright>
