#!/bin/bash
# xscale: X11 apps as sharp as Wayland ones, at the right size on every monitor.
#
#   xscale status      what is installed and what the running session does
#   xscale install     put xscale's Hyprland and Xwayland in place of Arch's
#                      (sudo pacman -U): this repository's prebuilt packages
#                      for the release Arch has, or, when there are none yet,
#                      built here. Then log out and back in.
#                        --no-build    never build here; fail instead
#                        --noconfirm   ask pacman nothing
#   xscale restore     put Arch's own Hyprland and Xwayland back
#   xscale uninstall   restore, then take xscale's links away (uninstall.sh)
#   xscale settings    tell X11 toolkits the scale they render at: the X
#                      resources (Xft.dpi, Xcursor.size) and XSETTINGS (GTK),
#                      on the running X display; run at every login by
#                      hypr/xscale.lua
#   xscale build       build xscale's Hyprland and Xwayland here, no install
#   xscale recipe NAME DIR
#                      Arch's recipe for NAME (hyprland or xorg-xwayland) at
#                      the version Arch has, with xscale's patch, in DIR; says
#                      the version it makes. Build it with
#                      GNUPGHOME=DIR/.gnupg makepkg (the keys Arch's recipe
#                      ships, for the source's signature)
#
# X11 has one coordinate space and one DPI for all its clients, so X11 apps
# render at one scale, the highest monitor's, and are shown at their logical
# size on every monitor. With xscale's Xwayland, Xwayland does that itself
# (xwayland_shell_v1 version 2, the scale event); with Arch's, Hyprland does.
set -euo pipefail

ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/xscale
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/xscale
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/xscale
# where the prebuilt packages are released
REPO=${XSCALE_REPO:-ParkerrDev/xscale}
PACKAGES=(xorg-xwayland hyprland)

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

die() {
  echo "xscale: $*" >&2
  exit 1
}

# The scale X11 clients render at in this session: xwayland:scale as Hyprland
# resolves it (-1 the highest monitor scale rounded up, -2 as it is), or, on a
# Hyprland without it, the highest monitor scale under force_zero_scaling and 1
# otherwise.
x11_scale() {
  local monitors highest option fzs
  monitors=$(hyprctl monitors -j 2>/dev/null) || die "no Hyprland to ask"
  highest=$(jq -r '[.[].scale] + [1] | max' <<<"$monitors")
  # a Hyprland without xscale's patch has no such option
  option=$(hyprctl getoption xwayland:scale -j 2>/dev/null | jq -r '.float // empty' 2>/dev/null || true)
  if [ -n "$option" ]; then
    awk -v s="$option" -v h="$highest" 'BEGIN {
      if (s == 0) { print 0; exit }
      if (s < -1.5) { v = h } else if (s < 0) { v = int(h - 0.001); if (v < h - 0.001) v += 1 } else { v = s }
      v = int(v * 120 + 0.5) / 120
      if (v < 1) v = 1
      print v
    }'
    return
  fi
  fzs=$(hyprctl getoption xwayland:force_zero_scaling -j 2>/dev/null | jq -r 'if .bool == true or .int == 1 then 1 else 0 end')
  if [ "$fzs" = 1 ]; then echo "$highest"; else echo 1; fi
}

# The X display of this session's Xwayland: DISPLAY, or the Xwayland the
# running Hyprland started (at login DISPLAY may not be set yet).
x11_display() {
  local hypr pid parent
  if [ -n "${DISPLAY:-}" ]; then
    echo "$DISPLAY"
    return
  fi
  hypr=$(hyprctl instances -j 2>/dev/null | jq -r --arg s "${HYPRLAND_INSTANCE_SIGNATURE:-}" '.[] | select(.instance == $s) | .pid' | head -1)
  [ -n "$hypr" ] || return 1
  for pid in $(pgrep -x Xwayland); do
    parent=$(ps -o ppid= -p "$pid" | tr -d ' ')
    if [ "$parent" = "$hypr" ]; then
      tr '\0' '\n' <"/proc/$pid/cmdline" | sed -n 2p
      return
    fi
  done
  return 1
}

# Text settings of the Wayland side, so that X11 GTK apps look the same
gsetting() {
  command -v gsettings >/dev/null || return 0
  gsettings get org.gnome.desktop.interface "$1" 2>/dev/null | sed "s/^'//; s/'\$//"
}

write_settings() {
  local scale=$1 gdk dpi unscaled cursor theme icons font gtk
  # GTK only scales by whole numbers: a fractional scale leaves GTK at the
  # whole part and scales its text by the rest
  gdk=$(awk -v s="$scale" 'BEGIN { v = int(s + 0.001); print (v < 1 ? 1 : v) }')
  dpi=$(awk -v s="$scale" 'BEGIN { printf "%d", 96 * s + 0.5 }')
  unscaled=$(awk -v s="$scale" -v g="$gdk" 'BEGIN { printf "%d", 96 * 1024 * s / g + 0.5 }')
  cursor=$(awk -v s="$scale" 'BEGIN { printf "%d", 24 * s + 0.5 }')
  theme=${XCURSOR_THEME:-$(gsetting cursor-theme)}
  icons=$(gsetting icon-theme)
  font=$(gsetting font-name)
  gtk=$(gsetting gtk-theme)

  mkdir -p "$CONFIG"
  {
    echo "! written by xscale settings for an X11 scale of $scale"
    echo "Xft.dpi: $dpi"
    echo "Xcursor.size: $cursor"
    [ -n "$theme" ] && echo "Xcursor.theme: $theme"
  } >"$CONFIG/Xresources"
  {
    echo "# written by xscale settings for an X11 scale of $scale"
    echo "Gdk/WindowScalingFactor $gdk"
    echo "Gdk/UnscaledDPI $unscaled"
    echo "Xft/DPI $((dpi * 1024))"
    echo "Gtk/CursorThemeSize 24"
    [ -n "$theme" ] && echo "Gtk/CursorThemeName \"$theme\""
    [ -n "$icons" ] && echo "Net/IconThemeName \"$icons\""
    [ -n "$font" ] && echo "Gtk/FontName \"$font\""
    [ -n "$gtk" ] && echo "Net/ThemeName \"$gtk\""
  } >"$CONFIG/xsettingsd.conf"
}

cmd_settings() {
  local scale display tries pidfile pid
  scale=$(x11_scale)
  [ "$scale" = 0 ] && scale=1
  write_settings "$scale"

  # Xwayland comes up a moment after Hyprland: wait for it, at most 15 s
  display=
  for tries in $(seq 1 30); do
    display=$(x11_display) && [ -n "$display" ] && break
    sleep 0.5
  done
  [ -n "$display" ] || die "no X display yet (is Xwayland on?)"
  : "$tries"

  DISPLAY=$display xrdb -merge "$CONFIG/Xresources"

  if command -v xsettingsd >/dev/null; then
    pidfile=${XDG_RUNTIME_DIR:-/tmp}/xscale-xsettingsd${display//[^0-9]/}.pid
    pid=$(cat "$pidfile" 2>/dev/null || true)
    if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = xsettingsd ]; then
      kill -HUP "$pid"
    else
      DISPLAY=$display setsid xsettingsd -c "$CONFIG/xsettingsd.conf" >/dev/null 2>&1 &
      echo $! >"$pidfile"
    fi
  else
    echo "xscale: xsettingsd is not installed, so X11 GTK apps keep a scale of 1 (omarchy pkg add xsettingsd)" >&2
  fi

  # Steam scales its interface by its own setting: for what Hyprland starts, for
  # what starts through systemd and D-Bus, and, through session/uwsm-env, for
  # the whole of the next session (launchers pass their own environment on)
  echo "export STEAM_FORCE_DESKTOPUI_SCALING=$scale" >"$CONFIG/env"
  hyprctl eval "hl.env(\"STEAM_FORCE_DESKTOPUI_SCALING\", \"$scale\")" >/dev/null 2>&1 || true
  dbus-update-activation-environment --systemd "STEAM_FORCE_DESKTOPUI_SCALING=$scale" >/dev/null 2>&1 ||
    systemctl --user set-environment "STEAM_FORCE_DESKTOPUI_SCALING=$scale" 2>/dev/null || true
  echo "xscale: X11 apps on $display render at $scale"
}


# Arch's version of NAME in the sync database: what `pacman -Syu` installs
arch_version() {
  LC_ALL=C pacman -Si "$1" 2>/dev/null | awk '/^Version / { sub(/^[^:]*: */, ""); print; exit }'
}

installed_version() {
  LC_ALL=C pacman -Q "$1" 2>/dev/null | awk '{ print $2 }'
}

# xscale's builds have a release number with a dot in it: Arch's plus .N
is_ours() {
  [[ $1 =~ -[0-9]+\.[0-9]+$ ]]
}

overlay_value() {
  sed -n "s/^_xscale_$2=//p" "$ROOT/pkg/$1/overlay.bash" | head -1 | tr -d '"'
}

# The version of xscale's build of NAME for the version Arch has
wanted_version() {
  local arch
  arch=$(arch_version "$1")
  [ -n "$arch" ] || die "pacman knows no $1"
  echo "$arch.$(overlay_value "$1" release)"
}

cmd_recipe() {
  local name=${1:-} dir=${2:-} version log patch
  [ -f "$ROOT/pkg/$name/overlay.bash" ] || die "recipe: hyprland or xorg-xwayland"
  [ -n "$dir" ] || die "recipe: say where to write it"
  # what is there is replaced, so it has to be an earlier recipe or nothing
  [ ! -e "$dir" ] || [ -f "$dir/PKGBUILD" ] || [ -z "$(ls -A "$dir")" ] || die "$dir holds something other than a recipe"
  version=$(arch_version "$name")
  [ -n "$version" ] || die "pacman knows no $name"
  rm -rf "$dir"
  # Arch tags each release in the package's own repository; an epoch's
  # colon becomes a dash
  log=$(git -c advice.detachedHead=false clone --quiet --depth 1 --branch "${version/:/-}" \
    "https://gitlab.archlinux.org/archlinux/packaging/packages/$name.git" "$dir" 2>&1) ||
    die "cannot fetch Arch's recipe for $name $version: $log"
  rm -rf "$dir/.git" "$dir/.SRCINFO"
  { echo; cat "$ROOT/pkg/$name/overlay.bash" "$ROOT/pkg/overlay.bash"; } >>"$dir/PKGBUILD"
  # every patch the overlay may pick; it picks by the version it builds
  for patch in $(overlay_value "$name" patches); do
    cp "$ROOT/patches/$patch" "$dir/"
  done
  # the source's signature is checked against the keys Arch's recipe ships
  # (keys/pgp), in a keyring of the recipe's own
  mkdir -m 700 "$dir/.gnupg"
  if [ -d "$dir/keys/pgp" ]; then
    GNUPGHOME=$dir/.gnupg gpg --quiet --batch --import "$dir"/keys/pgp/*.asc 2>/dev/null || true
    GNUPGHOME=$dir/.gnupg gpgconf --kill all 2>/dev/null || true
  fi
  echo "$version.$(overlay_value "$name" release)"
}

package_file() {
  echo "$CACHE/packages/$1-$2/$1-$2-$(uname -m).pkg.tar.zst"
}

# fetch NAME VERSION: xscale's NAME from this repository's release
# NAME-VERSION, checked against the release's SHA256SUMS. Fails when there is
# no such release (yet).
fetch_one() {
  local name=$1 want=$2 file out url
  file=$(package_file "$name" "$want")
  out=$(dirname "$file")
  url=https://github.com/$REPO/releases/download/$name-$want
  mkdir -p "$out"
  curl -fsSL --max-time 30 -o "$out/SHA256SUMS" "$url/SHA256SUMS" 2>/dev/null || return 1
  grep -q "  ${file##*/}\$" "$out/SHA256SUMS" || return 1
  echo "xscale: downloading ${file##*/}"
  curl -fL --max-time 900 --progress-bar -o "$file.part" "$url/${file##*/}" || return 1
  (cd "$out" && grep "  ${file##*/}\$" SHA256SUMS | sed 's/$/.part/' | sha256sum --check --quiet) ||
    die "${file##*/} does not match the checksum its release gives"
  mv "$file.part" "$file"
}

# build NAME VERSION: xscale's NAME built here, from cmd_recipe
build_one() {
  local name=$1 want=$2 dir=$CACHE/build/$1 file missing
  file=$(package_file "$name" "$want")
  command -v makepkg >/dev/null || die "building needs makepkg (sudo pacman -S --needed base-devel)"
  cmd_recipe "$name" "$dir" >/dev/null
  missing=$(cd "$dir" && makepkg --printsrcinfo | awk '$1 ~ /^(make|check)?depends$/ { print $3 }' | xargs pacman -T | sed 's/[<>=].*//' || true)
  if [ -n "$missing" ]; then
    echo "xscale: building $name needs ${missing//$'\n'/ }"
    # shellcheck disable=SC2086 # one package a word
    sudo pacman -S --needed --asdeps $missing
  fi
  mkdir -p "$(dirname "$file")"
  echo "xscale: building $name $want, which takes a while (log: $dir.log)"
  local built=yes
  (cd "$dir" && GNUPGHOME=$dir/.gnupg PKGDEST=$(dirname "$file") makepkg --force --cleanbuild >"$dir.log" 2>&1) || built=no
  # gpg may have started a daemon for that keyring
  GNUPGHOME=$dir/.gnupg gpgconf --kill all 2>/dev/null || true
  [ "$built" = yes ] || die "$name did not build: the end of $dir.log says why"
  [ -s "$file" ] || die "the build of $name made no ${file##*/}"
}

cmd_build() {
  local name want
  for name in "${PACKAGES[@]}"; do
    want=$(wanted_version "$name")
    build_one "$name" "$want"
    package_file "$name" "$want"
  done
}

cmd_install() {
  local build=yes confirm=() name want have file files=()
  while [ $# -gt 0 ]; do
    case $1 in
      --no-build) build=no ;;
      --noconfirm) confirm=(--noconfirm) ;;
      *) die "install takes --no-build and --noconfirm" ;;
    esac
    shift
  done
  [ "$(id -u)" != 0 ] || die "run it as yourself: it asks for sudo when it needs it"
  for name in "${PACKAGES[@]}"; do
    want=$(wanted_version "$name")
    have=$(installed_version "$name")
    if [ "$have" = "$want" ]; then
      echo "xscale: $name $want is in place"
      continue
    fi
    if is_ours "$have"; then have=${have%.*}; fi
    # A build for a newer Hyprland than the one here can need newer libraries
    [ -z "$have" ] || [ "$have" = "${want%.*}" ] ||
      die "$name is $have here and ${want%.*} in Arch: update first (omarchy update), then xscale install"
    file=$(package_file "$name" "$want")
    if [ ! -s "$file" ] && ! fetch_one "$name" "$want"; then
      [ "$build" = yes ] || die "there is no prebuilt $name $want yet; xscale install builds it here"
      echo "xscale: there is no prebuilt $name $want yet, so it is built here"
      build_one "$name" "$want"
    fi
    files+=("$file")
  done
  # X11 GTK apps learn their scale from XSETTINGS
  if ! pacman -T xsettingsd >/dev/null; then
    sudo pacman -S --needed "${confirm[@]}" xsettingsd
  fi
  mkdir -p "$STATE"
  touch "$STATE/packages"
  [ "${#files[@]}" -gt 0 ] || return 0
  sudo pacman -U --needed "${confirm[@]}" "${files[@]}"
  echo "xscale: installed. Log out and back in, and X11 apps are drawn at their monitors' scale."
}

cmd_restore() {
  local name targets=()
  rm -f "$STATE/packages"
  for name in "${PACKAGES[@]}"; do
    if is_ours "$(installed_version "$name")"; then targets+=("$name"); fi
  done
  if [ "${#targets[@]}" -eq 0 ]; then
    echo "xscale: Arch's Hyprland and Xwayland are in place"
    return 0
  fi
  echo "xscale: putting Arch's ${targets[*]} back"
  sudo pacman -S "${targets[@]}"
  echo "xscale: log out and back in to use them"
}

cmd_uninstall() {
  cmd_restore
  "$ROOT/uninstall.sh"
  rm -rf "$CACHE" "$STATE"
  echo "xscale: gone. This copy of it can go too: rm -rf $ROOT"
}

cmd_status() {
  local name have arch scale display
  for name in "${PACKAGES[@]}"; do
    have=$(installed_version "$name")
    arch=$(arch_version "$name")
    printf '%-14s %s' "$name" "${have:-not installed}"
    if is_ours "$have"; then printf ' (xscale)'; else printf " (Arch's)"; fi
    if [ -n "$arch" ] && [ "${have%.*}" != "$arch" ] && [ "$have" != "$arch" ]; then printf ', Arch has %s' "$arch"; fi
    echo
  done
  if hyprctl version >/dev/null 2>&1; then
    scale=$(x11_scale)
    display=$(x11_display || echo none)
    echo "session        X11 apps render at $scale on display $display"
  fi
  [ -e "$CONFIG/Xresources" ] && echo "settings       $(grep -v '^!' "$CONFIG/Xresources" | tr '\n' ' ')"
  return 0
}

case "${1:-}" in
  status) cmd_status ;;
  install) shift; cmd_install "$@" ;;
  restore) cmd_restore ;;
  uninstall) cmd_uninstall ;;
  settings) cmd_settings ;;
  build) cmd_build ;;
  recipe) shift; cmd_recipe "$@" ;;
  -h | --help | help | "") usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
